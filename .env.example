BOT_ACCESS_TOKEN_COUNT=4
BOT_PERSIST_TOKENS=true

# Timing & throttle
BOT_DELAY_MS=60000
BOT_DELAY_JITTER_MS=5000
BOT_BREAK_EVERY=0
BOT_BREAK_MS=0
BOT_MAX_PER_RUN=0
BOT_MAX_PER_HOUR=0
BOT_MAX_PER_DAY=0

# Server
PORT=3001

# Evolution API (example)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=

CHATWOOT_URL=https://app.chatwoot.com
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_TOKEN=

# Database / Session
DATABASE_URL=
SESSION_SECRET=
AUTH_ALLOWED_DOMAIN=bfrcapital.com.br

# Frontend (set to your host IP to allow other machines to reach backend)
VITE_BACKEND_URL=http://192.168.2.176:3001
VITE_SOCKET_URL=ws://192.168.2.176:3001
VITE_FRONTEND_PORT=3000
VITE_BASE=/

# CORS allowed origins (comma separated)
CORS_ALLOWED_ORIGINS=
